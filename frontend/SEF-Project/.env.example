# Copy to .env (gitignored) and fill in your own values.
#
# Base URL of the shared ASP.NET Core API (defaults to localhost).
# VITE_API_BASE_URL=http://localhost:5193/api

# Stripe publishable (public) key for the payment sandbox. This key is safe to
# expose to the browser. Without it, card checkout falls back to the manual
# (staff-confirmed) payment flow.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
