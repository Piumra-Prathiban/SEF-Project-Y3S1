{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "PersonalStylistAgent": {
    "Provider": "Local",
    "OverallTimeoutSeconds": 20,
    "ToolTimeoutSeconds": 5,
    "MaximumToolAttempts": 2
  },

  "InventoryAnalysisAgent": {
    "Provider": "Local"
  },

  "DeepSeek": {
    "Model": "deepseek-chat",
    "Endpoint": "https://api.deepseek.com/chat/completions"
  },

  "InventoryPromotionAgent": {
    "Provider": "Local"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  }
}
