# Copy to .env (gitignored) and fill in your own values:
#   cp .env.example .env
#
# The API loads .env at startup. Double underscores map to nested configuration
# keys, so SeedAdmin__Email sets SeedAdmin:Email. Any setting works the same way
# (e.g. Jwt__Key, ConnectionStrings__DefaultConnection), and real environment
# variables always win over this file.

# Bootstrap Administrator, created on the first start when it does not exist.
SeedAdmin__Email=admin@clothic.local
SeedAdmin__Password=change-me
SeedAdmin__FirstName=Clothic
SeedAdmin__LastName=Admin
