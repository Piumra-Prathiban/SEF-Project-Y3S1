# Copy to .env (gitignored) and fill in your own values:
#   cp .env.example .env
#
# The API loads .env at startup. Double underscores map to nested configuration
# keys, so SeedAdmin__Email sets SeedAdmin:Email. Any setting works the same way
# (e.g. Jwt__Key, ConnectionStrings__DefaultConnection), and real environment
# variables always win over this file.

# Bootstrap Administrator, created on the first start when it does not exist.
SeedAdmin__Email=admin@clothic.local
SeedAdmin__Password=change-me
SeedAdmin__FirstName=Clothic
SeedAdmin__LastName=Admin

# Optional real model-backed Personal Stylist. Local remains the safe default.
# PersonalStylistAgent__Provider=OpenAI
# PersonalStylistAgent__Model=gpt-5-mini
# PersonalStylistAgent__ApiKey=YOUR_OPENAI_API_KEY

# Optional real model-backed Inventory Analysis Agent. Local stays the safe
# default; the shared DeepSeek section supplies the key/model/endpoint.
# InventoryAnalysisAgent__Provider=DeepSeek

# Shared DeepSeek transport used by model-backed agents.
# DeepSeek__ApiKey=YOUR_DEEPSEEK_API_KEY
# DeepSeek__Model=deepseek-chat
# DeepSeek__Endpoint=https://api.deepseek.com/chat/completions

# Optional real model-backed Inventory & Promotion Agent. The structured local
# policy remains the development fallback when these values are not enabled.
# InventoryPromotionAgent__Provider=OpenAI
# InventoryPromotionAgent__Model=gpt-5-mini
# InventoryPromotionAgent__ApiKey=YOUR_OPENAI_API_KEY

# Password shared by the three local demo accounts created with:
#   dotnet run -- seed-demo
# This command is blocked outside the Development environment.
# DemoData__Password=Demo123!
